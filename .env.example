# Copy to .env locally. Never commit secrets. No live provider or chain defaults.
DATABASE_URL=postgresql+psycopg://framebounty:framebounty@localhost:5432/framebounty
APP_MODE=fixture
AUTH_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
GEMINI_API_KEY=
GEMINI_MODEL=
ARC_RPC_URL=
ARC_CHAIN_ID=5042002
# Mainnet is chain 5042 with APP_MODE=mainnet. Keep separate DB/storage/keys.
ALLOW_MAINNET_TRANSACTIONS=false
NEXT_PUBLIC_ARC_CHAIN_ID=5042002
MAINNET_SPEND_LIMIT_USDC=1.000000
CIRCLE_ENABLED=false
CIRCLE_APP_ID=
CIRCLE_API_KEY=
CIRCLE_LOGIN_METHOD=google
CIRCLE_GOOGLE_CLIENT_ID=
DATABASE_SCHEMA=
STORAGE_BACKEND=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=framebounty-media
RUN_CHAIN_WORKER=false
# Hosted mainnet requires persistent Railway /data volume, never ephemeral disk.
MAINNET_BUDGET_PATH=
ARC_USDC_ADDRESS=
ARC_ESCROW_ADDRESS=
ARC_ALLOCATOR_ADDRESS=
# Dedicated testnet allocator only. Never use a buyer/reviewer wallet key.
ARC_ALLOCATOR_PRIVATE_KEY=
ALLOW_CHAIN_TRANSACTIONS=false
NEXT_PUBLIC_ENABLE_CHAIN_FUNDING=false
# Optional, display-only: public escrow address linked to the Arc explorer in the UI.
NEXT_PUBLIC_ARC_ESCROW_ADDRESS=
STORAGE_ROOT=.local/media
ALLOW_MODEL_MEDIA=false
ALLOW_MODEL_TEXT=false
FIXTURE_VERIFICATION_RESULT=uncertain
ALLOW_LIVE_MODEL_SMOKE=false
GEMINI_FREE_TIER_CONFIRMED=false
# Optional absolute portable executable paths; otherwise use .local/ffmpeg or PATH.
FFMPEG_BIN=
FFPROBE_BIN=
# Chain transactions remain disabled unless explicitly enabled above.
